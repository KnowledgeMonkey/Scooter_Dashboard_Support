; Run against the dashboard's actual gesture and configuration code.
(load-settings)
(def clicks-disabled (not bldc-shortcut))
(save-group 'commutation '(true))
(load-settings)
(def saved-ok (and bldc-shortcut (= (eeprom-read-i 118) 1)))
(setq button-safety-speed (/ 9999.0 3.6))
(setq software-adc true)
(setq software-adc2 true)
(setq thr-corr-v 0.8)
(def hardware-mode 2)
(def hardware-dir 0)
(def wheel 0)
(def rpm 0)
(def duty 0.0)
(def amps 0.0)
(def fault 0)
(def adc-ok true)
(def throttle 0.0)
(def brake 0.0)
(def peers nil)
(def inhibited nil)
(def zeroed nil)
(def writes 0)
(def fail-mode nil)
(def refuse-rollback nil)
(def coerce-mode nil)
(def bad-write nil)
(def fail-mark nil)
(def fail-clear nil)
(def raw-get conf-get)
(defun conf-get (k)
    (cond ((eq k 'motor-type) hardware-mode) ((eq k 'm-invert-direction) hardware-dir)
          (t (raw-get k))))
(defun secs-since (s) (/ (- clock s) 10000.0))
(defun get-speed () wheel)
(defun get-rpm () rpm)
(defun get-current () amps)
(defun get-duty () duty)
(defun get-fault () fault)
(defun app-adc-range-ok () adc-ok)
(defun can-list-devs () peers)
(defun get-adc-decoded (n) (if (= n 0) throttle brake))
(defun app-is-output-disabled () inhibited)
(defun app-disable-output (ms) (setq inhibited (!= ms 0)))
(defun set-current-rel (n) (setq zeroed (and inhibited (= n 0))))
(def store-int eeprom-store-i)
(defun eeprom-store-i (a v)
    (if (and (= a 119) (if (= v 0) fail-clear fail-mark)) nil (store-int a v)))
(defun conf-set (k v) {
    (setq writes (+ writes 1))
    (if (not (and inhibited zeroed (eeprom-read-i 119) (> (eeprom-read-i 119) 0)))
        (setq bad-write true))
    (cond ((eq k 'm-invert-direction)
           (if (and refuse-rollback (= v 0)) nil { (setq hardware-dir v) t }))
          ((eq k 'motor-type)
           (if (and fail-mode (= v 0)) (exit-error 'rejected)
               { (if (not coerce-mode) (setq hardware-mode v)) t }))
          (t (exit-error 'unexpected-setting)))
})
(defun step (down ticks) {
    (setq clock (+ clock ticks))
    (setq last-rx clock)
    (sample-button down)
    (button-apply down)
})
(defun four-clicks () {
    (looprange i 0 4 { (step true 650) (step false 650) })
    (step false 3100)
})
(defun settle () {
    (setq clock (+ clock 6000))
    (setq last-rx clock)
    (update-drive-hold)
})
(defun expect (value label) (if (not value) (exit-error label)))
(expect (and clicks-disabled saved-ok) 'settings)
(setq bldc-shortcut false)
(four-clicks)
(expect (= writes 0) 'opt-in)
(setq bldc-shortcut true)
; Existing configured button mappings have priority.
(setq light-presses 4)
(four-clicks)
(expect (and light (= writes 0)) 'collision)
(setq light-presses 1)
(looprange direction 0 2 {
    (setq hardware-mode 2) (setq hardware-dir direction)
    (four-clicks)
    (expect (and (drive-pair 0 (- 1 direction)) (eq drive-hold 'neutral)
                 inhibited (= (eeprom-read-i 119) 0)) 'bldc)
    (setq throttle 0.2) (settle)
    (expect drive-hold 'held-after-switch)
    (setq throttle 0.0) (update-drive-hold)
    (expect drive-hold 'hold-time)
    (settle)
    (expect (not drive-hold) 'neutral-rearm)
    (app-disable-output 0) (setq zeroed nil)
    (four-clicks)
    (expect (and (drive-pair 2 direction) inhibited (eq drive-hold 'neutral)) 'foc)
    (settle) (app-disable-output 0)
})
(def initial-writes writes)
; Seek the same action through the button handler at riding speed.
(setq wheel 1.0) (four-clicks) (setq wheel -1.0) (four-clicks) (setq wheel 0)
(loopforeach input '(amps duty fault throttle brake thr-corr-v lock off cruising peers calib-stage) {
    (var before (eval input))
    (set input (if (eq input 'thr-corr-v) 1.02 1))
    (switch-drive) (set input before)
})
(setq adc-ok nil) (switch-drive) (setq adc-ok true)
(setq rpm 6) (switch-drive) (setq rpm 0)
(setq last-rx (- clock 8000)) (switch-drive) (setq last-rx clock)
(setq hardware-mode 1) (switch-drive) (setq hardware-mode 2)
(setq hardware-dir 7) (switch-drive) (setq hardware-dir 0)
(expect (and (= initial-writes writes) (not drive-hold)) 'blocked-inputs)
(setq fail-mark true) (switch-drive) (setq fail-mark nil)
(expect (and (= initial-writes writes) (drive-pair 2 0)) 'marker-first)
(settle)
(setq fail-mode true) (switch-drive)
(expect (and (drive-pair 2 0) (eq drive-hold 'neutral)) 'rollback)
(settle) (setq fail-mode nil)
(setq coerce-mode true) (switch-drive) (setq coerce-mode nil)
(expect (and (drive-pair 2 0) (eq drive-hold 'neutral)) 'readback)
(settle)
(setq fail-mode true) (setq refuse-rollback true) (switch-drive)
(expect (and (drive-pair 2 1) (eq drive-hold 'blocked) inhibited
             (= (eeprom-read-i 119) 19762)) 'failed-rollback)
(setq drive-hold nil) (setq inhibited nil) (resume-drive) (settle)
(expect (and inhibited (eq drive-hold 'blocked)) 'partial-restart)
(setq hardware-dir 0) (setq fail-mode nil) (setq refuse-rollback nil)
(resume-drive) (settle)
(expect (and (not drive-hold) (= (eeprom-read-i 119) 0)) 'saved-pair-recovery)
(setq fail-clear true) (switch-drive)
(expect (and (drive-pair 0 1) inhibited (eq drive-hold 'blocked)) 'clear-failure)
(setq fail-clear nil) (resume-drive) (settle)
(expect (and (not drive-hold) (= (eeprom-read-i 119) 0)) 'completed-pair-recovery)
; Exercise the normal output gate with kick-start both enabled and disabled.
(defun check-slip () t)
(defun get-lowest-speed () wheel)
(defun get-batt () 0.6)
(defun app-run-todo () t)
(defun app-cache-update () t)
(defun handle-taillight () t)
(defun handle-lock (v) t)
(defun handle-cruise (v) t)
(setq min-speed 0) (setq unlock nil)
(setq drive-hold 'blocked) (handle-features)
(expect inhibited 'normal-loop-blocked)
(setq drive-hold 'neutral) (setq throttle 0.1) (handle-features)
(expect inhibited 'normal-loop-throttle)
(setq throttle 0) (setq clock (+ clock 6000)) (setq last-rx clock)
(setq min-speed 3) (handle-features)
(expect (and (not drive-hold) inhibited) 'kick-start-still-active)
(setq wheel 1.0) (handle-features)
(expect (not inhibited) 'normal-loop-rearmed)
(check (not bad-write))
